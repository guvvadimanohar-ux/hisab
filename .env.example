# ==============================================================================
# HISAB — ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ==============================================================================

# Server Configuration
PORT=8099
NODE_ENV=development
DEMO_MODE=true

# Database Configuration (Persistent SQLite / Database URL)
DATABASE_URL=./hisab_financial.db
HISAB_DB_PATH=./hisab_financial.db

# Authentication Secret
AUTH_SECRET=hisab_super_secret_auth_token_key_change_in_production

# ------------------------------------------------------------------------------
# ACCOUNT AGGREGATOR (AA) — CONSENT-BASED BANK DATA
# ------------------------------------------------------------------------------
# Mode: mock | live
ACCOUNT_AGGREGATOR_MODE=mock
AA_MOCK_MODE=false
AA_ENVIRONMENT=sandbox # sandbox | production

# Provider: setu | finvu
AA_PROVIDER=setu

# Setu / Finvu Credentials (Server-side ONLY. Never expose to frontend)
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_PRODUCT_ID=
AA_FIU_ID=
AA_BASE_URL=https://fiu-sandbox.setu.co
AA_CALLBACK_URL=http://localhost:8099/api/bank/callback
AA_WEBHOOK_URL=http://localhost:8099/api/bank/webhook
AA_WEBHOOK_SECRET=

# Finvu AA credentials (alternative provider)
FINVU_CLIENT_ID=
FINVU_CLIENT_SECRET=

# Initial synchronization window
INITIAL_TRANSACTION_DAYS=90

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (DIGITAL PAYMENTS & UPI COLLECTION)
# ------------------------------------------------------------------------------
# Provider: mock | razorpay | cashfree
PAYMENT_GATEWAY=mock
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_MODE=true

# Unified Payment Gateway Credentials
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Razorpay Credentials (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree Credentials (https://merchant.cashfree.com)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENVIRONMENT=sandbox

# ------------------------------------------------------------------------------
# AI ASSISTANT (FINANCIAL REASONING & TOOLS)
# ------------------------------------------------------------------------------
AI_PROVIDER=local
# Set AI_PROVIDER=groq to use the hosted business assistant.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
DEFAULT_AI_LANGUAGE=auto
# Assistant records only explicit validated business entries; never payments or deletions.
# Ollama must already be running with OLLAMA_MODEL installed.
AI_READ_ONLY_MODE=false

# ------------------------------------------------------------------------------
# VOICE ASSISTANT & REGIONAL SPEECH (STT / TTS)
# ------------------------------------------------------------------------------
VOICE_PROVIDER=mock # mock | cloud | google | bhashini
VOICE_STT_API_KEY=
VOICE_TTS_API_KEY=


# Verified details required before public launch (shown on policies/settings).
HISAB_OPERATOR_NAME=
HISAB_OPERATOR_ADDRESS=
HISAB_PRIVACY_EMAIL=
# Enable only behind HTTPS; local HTTP development leaves this false.
COOKIE_SECURE=false

# Optional Google Analytics 4 (public measurement ID, not a secret)
GA_MEASUREMENT_ID=
